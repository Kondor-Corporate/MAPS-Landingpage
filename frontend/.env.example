# Opcional en desarrollo: si se omite, /api/v1 usa el proxy de Vite hacia
# http://127.0.0.1:3000 sin incluir esa URL en el bundle.
# En staging construir explícitamente con:
# VITE_API_BASE_URL=/api/v1

# Build-time (Vite). Quedan horneadas en dist/index.html al construir.
# No son variables runtime de Cloud Run ni del entrypoint de Nginx.
# Si se omiten, robots queda noindex,nofollow (seguro para local/staging).
# VITE_PUBLIC_INDEXING=false
# VITE_PUBLIC_SITE_URL debe ser el origen HTTPS público oficial, sin path,
# query, fragment ni barra final. Obligatoria solo si INDEXING=true.
# VITE_PUBLIC_SITE_URL=https://origen-publico-oficial

# Runtime exclusivo del contenedor Nginx (no es variable Vite).
# En staging debe ser el origen HTTPS del servicio backend Cloud Run, sin /api,
# path, query, fragment ni barra final.
# BACKEND_ORIGIN=https://backend-ejemplo.run.app
