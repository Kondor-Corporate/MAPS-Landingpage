# Copiar a .env en esta carpeta (backend/)

# Runtime
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Reverse proxy: en local usar false (default). Detrás de nginx/LB: true o nº de saltos (1, 2, …).
# TRUST_PROXY=false

# Producción: por defecto no se acepta refresh en el body (solo cookie). Para excepciones explícitas:
# ALLOW_REFRESH_BODY=false

# Base de datos — backend en tu máquina contra Postgres del Compose (mapeo 5432:5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maps_asesores_dev"
# Si el backend corriera dentro de Docker en la misma red que el servicio `db`, usar host `db`:
# DATABASE_URL="postgresql://postgres:postgres@db:5432/maps_asesores_dev"
# Si tenés otro Postgres nativo en 5432, desinstalalo o cambiá el mapeo a 5433:5432 y usá localhost:5433.

# Auth / JWT
# Valores de desarrollo. Cambiar en producción y no commitear secretos reales.
JWT_SECRET=dev_access_secret_change_me_32_chars_minimum
JWT_EXPIRES_IN=15m
REFRESH_SECRET=dev_refresh_secret_change_me_32_chars_minimum
REFRESH_EXPIRES_IN=30d

# Contraseña usada solo por prisma/seed.ts para los productores de ejemplo (opcional).
# Desde MAPS-016 el alta real de productores pide `password` individual en el formulario/API.
DEFAULT_PRODUCER_PASSWORD=Dev_DefaultProducer_12chars

# Storage de certificaciones (PDF)
# local = disco en backend/uploads/certificaciones (desarrollo)
# s3    = bucket S3-compatible (producción)
STORAGE_PROVIDER=local
API_PUBLIC_URL=http://localhost:3000

# Solo si STORAGE_PROVIDER=s3
# S3_BUCKET=maps-certificaciones
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.ejemplo.com

# Geocodificación (Nominatim / OpenStreetMap)
NOMINATIM_USER_AGENT=maps-landingpage-dev/1.0 (contact@kondor.local)
