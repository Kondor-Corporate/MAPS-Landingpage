generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int           @id @default(autoincrement())
  activo       Boolean       @default(true)
  usuario      String        @unique
  passwordHash String        @map("password_hash")
  rol          Rol           @default(PRODUCTOR)
  creadoPorId  Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLoginAt  DateTime?     @map("last_login_at")
  tokenVersion Int           @default(0) @map("token_version")
  noticias     Noticia[]
  productor    Productor?
  recursos     Recurso[]
  creadoPor    Usuario?      @relation("CreadoPor", fields: [creadoPorId], references: [id])
  creadados    Usuario[]     @relation("CreadoPor")
  sesiones     SesionToken[]
}

model SesionToken {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sesion_token")
}

model Productor {
  id                Int             @id @default(autoincrement())
  usuarioId         Int             @unique
  slug              String          @unique
  nombre            String
  apellido          String
  bio               String?
  ciudad            String?
  dni               String?         @unique
  foto              String?
  latitud           Float?
  longitud          Float?
  telefono          String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  matricula         String?         @unique
  verificado        Boolean         @default(false)
  idiomas           Json?
  whatsapp          String?
  anosExperiencia   Int?            @map("anos_experiencia")
  clientesActivos   Int?            @map("clientes_activos")
  tituloProfesional String?         @map("titulo_profesional")
  especialidades    String?
  direccion         String?
  certificaciones   Certificacion[]
  usuario           Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  redesSociales     RedSocial[]
}

model Certificacion {
  id          Int       @id @default(autoincrement())
  productorId Int       @map("productor_id")
  nombre      String
  archivoUrl  String    @map("archivo_url")
  tamanoBytes Int?      @map("tamano_bytes")
  mimeType    String    @default("application/pdf") @map("mime_type")
  orden       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  productor   Productor @relation(fields: [productorId], references: [id], onDelete: Cascade)

  @@index([productorId])
  @@map("Certificacion")
}

model RedSocial {
  id          Int       @id @default(autoincrement())
  productorId Int
  plataforma  String
  url         String
  orden       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  productor   Productor @relation(fields: [productorId], references: [id], onDelete: Cascade)

  @@index([productorId])
}

model Noticia {
  id          Int              @id @default(autoincrement())
  titulo      String
  slug        String           @unique
  descripcion String?
  contenido   String
  imagenUrl   String?          @map("imagen_url")
  publicada   Boolean          @default(false)
  publicadaEn DateTime?        @map("publicada_en")
  visibilidad Visibilidad      @default(PUBLICA)
  autorId     Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  categoria   CategoriaNoticia
  autor       Usuario          @relation(fields: [autorId], references: [id])
  imagenes    NoticiaImagen[]

  @@index([autorId])
  @@index([publicada, visibilidad])
}

model NoticiaImagen {
  id          Int      @id @default(autoincrement())
  noticiaId   Int      @map("noticia_id")
  url         String
  orden       Int      @default(0)
  mimeType    String   @map("mime_type")
  tamanoBytes Int?     @map("tamano_bytes")
  createdAt   DateTime @default(now()) @map("created_at")
  noticia     Noticia  @relation(fields: [noticiaId], references: [id], onDelete: Cascade)

  @@index([noticiaId])
}

model Biblioteca {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ramos       Ramo[]
}

model Ramo {
  id           Int        @id @default(autoincrement())
  bibliotecaId Int
  nombre       String
  descripcion  String?
  orden        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  icono        String
  gdriveUrl    String
  tipo         RamoTipo   @default(PRINCIPAL)
  activo       Boolean    @default(true)
  biblioteca   Biblioteca @relation(fields: [bibliotecaId], references: [id], onDelete: Cascade)
  recursos     Recurso[]

  @@unique([bibliotecaId, nombre])
  @@index([bibliotecaId])
}

model Recurso {
  id          Int      @id @default(autoincrement())
  ramoId      Int
  url         String
  subidoPorId Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ramo        Ramo     @relation(fields: [ramoId], references: [id], onDelete: Cascade)
  subidoPor   Usuario  @relation(fields: [subidoPorId], references: [id])

  @@index([ramoId])
  @@index([subidoPorId])
}

enum Rol {
  SUPERADMIN
  ADMIN
  PRODUCTOR
}

enum Visibilidad {
  INTERNA
  PUBLICA
  AMBAS
}

enum RamoTipo {
  PRINCIPAL
  SECUNDARIO
}

enum CategoriaNoticia {
  NOVEDAD
  EVENTO
  CIRCULAR
  PRODUCTO
  COMUNICADO
}
