// Esquema inicial — ampliar modelos en iteraciones posteriores
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo mínimo para la primera migración — reemplazar/ampliar según dominio
model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}
