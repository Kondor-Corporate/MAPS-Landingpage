# ============================================================
# MAPS Asesores — .gitignore
# Cubre: Node/TS, Vite/React (frontend), Express/Prisma (backend)
# ============================================================

# ── Dependencies ────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build outputs ───────────────────────────────────────────
dist/
build/
frontend/dist/
backend/dist/

# ── Environment variables ────────────────────────────────────
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
backend/.env
backend/.env.local
backend/.env.*.local

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo

# ── Vite ────────────────────────────────────────────────────
frontend/.vite/

# ── Prisma ───────────────────────────────────────────────────
# Mantener schema.prisma y migrations/ en git
# Ignorar el cliente generado
backend/node_modules/.prisma/
backend/src/generated/

# ── Testing ──────────────────────────────────────────────────
coverage/
.nyc_output/

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ─────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Claude Code / agentes ────────────────────────────────────
# Metadatos locales del CLI de Claude Code y skills/agents.
# No representan codigo de la app y varian entre maquinas.
.claude/
.agents/
skills-lock.json

# ── Docker ───────────────────────────────────────────────────
# docker-compose.yml SÍ se versiona; ignorar overrides locales
docker-compose.override.yml

# ── Uploads (certificaciones PDF MAPS-013) ───────────────────
backend/uploads/

# ── Misc ─────────────────────────────────────────────────────
*.local
.cache/
tmp/

# ── Artefactos de modelado (Enterprise Architect, etc.) ──────
# Los archivos .EAP y .bmp del modelo de dominio son binarios
# pesados sin valor de diff en git. Mantener en repo de docs
# externo o usar Git LFS si se requiere historial.
*.EAP
*.ldb
Arquitectura/**/*.bmp
.tmp